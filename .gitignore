/assets/pure_live_web/

# FVM Version Cache
.fvm/
**/.make_config.yaml
# Local HarmonyOS build artifacts inside the vendored AVPlayer plugin
vendor/media_core_avplayer/ohos/oh_modules/
vendor/media_core_avplayer/ohos/build/
vendor/media_core_avplayer/ohos/.hvigor/
vendor/media_core_avplayer/ohos/local.properties

# Local device screenshots and build logs (鸿蒙真机验证产物，不入库)
/test_capture/

# 本地发行包暂存（上传 Release 用，不入库）
/dist/
